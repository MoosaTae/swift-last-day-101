---
import '../styles/global.css';
import pages from '../data/pages.json';
import CommandPalette from '../components/CommandPalette';

interface Props {
  title: string;
  active?: string;
  wide?: boolean;
}

const { title, active = '', wide = false } = Astro.props;
const containerClass = wide
  ? 'mx-auto max-w-5xl px-4 sm:px-6 py-8 pt-16 md:pt-8'
  : 'mx-auto max-w-3xl px-4 sm:px-6 py-8 pt-16 md:pt-8';

const knowledge = Object.entries(pages.knowledge ?? {}).sort(([a], [b]) => a.localeCompare(b));
const learn = Object.entries(pages.learn ?? {}).sort(([a], [b]) => a.localeCompare(b));
const mock = Object.entries(pages.mock ?? {}).sort(([a], [b]) => a.localeCompare(b));

const linkClass = (href: string) => {
  const base = 'block rounded-md px-3 py-1.5 text-sm transition-colors';
  return active === href
    ? `${base} bg-zinc-800 text-zinc-100 font-medium`
    : `${base} text-zinc-400 hover:bg-zinc-800/60 hover:text-zinc-200`;
};
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <button
      type="button"
      data-sidebar-open
      class="fixed top-3 left-3 z-50 inline-flex h-9 w-9 items-center justify-center rounded-md border border-zinc-700 bg-zinc-900/90 text-zinc-200 backdrop-blur hover:bg-zinc-800 md:hidden"
      aria-label="Open menu"
    >
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
        <path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round" />
      </svg>
    </button>
    <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-black/60 backdrop-blur-sm md:hidden"></div>
    <div class="flex min-h-screen">
      <aside
        data-sidebar
        class="fixed md:sticky inset-y-0 left-0 z-40 w-64 md:w-60 shrink-0 border-r border-zinc-800 bg-zinc-950 px-3 py-5 md:top-0 h-screen overflow-y-auto -translate-x-full md:translate-x-0 transition-transform duration-200 ease-out"
      >
        <div class="flex items-start justify-between gap-2 px-3 pb-4 mb-2 border-b border-zinc-800">
          <a href="/" class="block">
            <div class="text-sm font-semibold text-zinc-100">iOS Final</div>
            <div class="text-xs text-zinc-500">May 9 - 14:00</div>
          </a>
          <div class="flex items-center gap-1">
            <button
              type="button"
              data-cmdk-trigger
              class="shrink-0 mt-0.5 inline-flex items-center gap-1 rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 text-[11px] text-zinc-300 hover:bg-zinc-800"
              aria-label="Open search"
            >
              <span>Search</span>
              <kbd class="font-sans text-[10px] text-zinc-400">{'⌘K'}</kbd>
            </button>
            <button
              type="button"
              data-sidebar-close
              class="md:hidden shrink-0 mt-0.5 inline-flex h-7 w-7 items-center justify-center rounded-md border border-zinc-700 bg-zinc-900 text-zinc-300 hover:bg-zinc-800"
              aria-label="Close menu"
            >
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5">
                <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
              </svg>
            </button>
          </div>
        </div>

        <nav class="space-y-5">
          <div>
            <a href="/" class={linkClass('/')}>Drill</a>
          </div>

          <div>
            <div class="px-3 mb-1 text-xs uppercase tracking-wider text-zinc-500">Knowledge</div>
            <a href="/knowledge/" class={linkClass('/knowledge/')}>All topics</a>
            {knowledge.map(([slug, p]) => (
              <a href={`/knowledge/${slug}`} class={linkClass(`/knowledge/${slug}`)}>
                <span class="text-zinc-600 mr-2">{slug}</span>{p.title}
              </a>
            ))}
          </div>

          <div>
            <div class="px-3 mb-1 text-xs uppercase tracking-wider text-zinc-500">Learn</div>
            <a href="/learn/" class={linkClass('/learn/')}>All topics</a>
            {learn.map(([slug, p]) => (
              <a href={`/learn/${slug}`} class={linkClass(`/learn/${slug}`)}>
                <span class="text-zinc-600 mr-2">{slug}</span>{p.title}
              </a>
            ))}
          </div>

          <div>
            <div class="px-3 mb-1 text-xs uppercase tracking-wider text-zinc-500">Mock Exam</div>
            <a href="/mock/" class={linkClass('/mock/')}>Overview</a>
            {mock.map(([slug, p]) => (
              <a href={`/mock/${slug}`} class={linkClass(`/mock/${slug}`)}>
                <span class="text-zinc-600 mr-2">{slug}</span>{p.title}
              </a>
            ))}
          </div>
        </nav>
      </aside>

      <main class="flex-1 min-w-0">
        <div class={containerClass}>
          <slot />
        </div>
      </main>
    </div>
    <CommandPalette client:load />
    <script>
      document.querySelectorAll('[data-cmdk-trigger]').forEach(el => {
        el.addEventListener('click', () => {
          const isMac = navigator.platform.toLowerCase().includes('mac');
          const ev = new KeyboardEvent('keydown', {
            key: 'k',
            metaKey: isMac,
            ctrlKey: !isMac,
            bubbles: true,
          });
          window.dispatchEvent(ev);
        });
      });

      const sidebar = document.querySelector('[data-sidebar]') as HTMLElement | null;
      const backdrop = document.querySelector('[data-sidebar-backdrop]') as HTMLElement | null;
      const openBtns = document.querySelectorAll('[data-sidebar-open]');
      const closeBtns = document.querySelectorAll('[data-sidebar-close]');
      const mq = window.matchMedia('(min-width: 768px)');

      function setOpen(open: boolean) {
        if (!sidebar || !backdrop) return;
        if (open) {
          sidebar.classList.remove('-translate-x-full');
          sidebar.classList.add('translate-x-0');
          backdrop.classList.remove('hidden');
          document.body.style.overflow = mq.matches ? '' : 'hidden';
        } else {
          sidebar.classList.add('-translate-x-full');
          sidebar.classList.remove('translate-x-0');
          backdrop.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      function syncForViewport() {
        if (!sidebar || !backdrop) return;
        if (mq.matches) {
          // desktop: always visible, no backdrop, no body lock
          sidebar.classList.remove('-translate-x-full');
          sidebar.classList.add('translate-x-0');
          backdrop.classList.add('hidden');
          document.body.style.overflow = '';
        } else {
          // mobile: closed by default
          setOpen(false);
        }
      }

      openBtns.forEach(b => b.addEventListener('click', () => setOpen(true)));
      closeBtns.forEach(b => b.addEventListener('click', () => setOpen(false)));
      backdrop?.addEventListener('click', () => setOpen(false));

      // close on link click (mobile only)
      sidebar?.querySelectorAll('a[href]').forEach(a => {
        a.addEventListener('click', () => {
          if (!mq.matches) setOpen(false);
        });
      });

      mq.addEventListener('change', syncForViewport);
      syncForViewport();
    </script>
  </body>
</html>
